rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Participant audio scratchpad recordings: authenticated participants may
    // upload their own audio; reads are via the Admin SDK only (researchers).
    match /participant_audio/{experimentId}/{participantId}/{fileName} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
